# Copy to .env.local and adjust for your deployment.
# Public site URL used for canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.oramaxclinic.in

# Google Maps: this site uses a keyless embed (no API key required).
# If you switch to the Maps Embed API with a Place ID, add:
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Never commit real keys. Never use private keys in client components.

# Optional analytics (privacy-friendly only, e.g. Plausible/Umami).
# NEXT_PUBLIC_ANALYTICS_DOMAIN=
